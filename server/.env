# .env.example - Copy this to .env and update the values

# Server Configuration
# NODE_ENV=development
# PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false

# Database Configuration
MONGODB_URL=mongodb://localhost:27017/notification_system
DB_MAX_POOL_SIZE=10
DB_SERVER_SELECTION_TIMEOUT=5000
DB_SOCKET_TIMEOUT=45000
DB_HEARTBEAT_FREQUENCY=10000
DB_MAX_IDLE_TIME=30000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please-make-it-long-and-random
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Client URLs (comma-separated for production)
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Socket.IO Configuration
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
SOCKET_UPGRADE_TIMEOUT=30000
SOCKET_MAX_BUFFER_SIZE=1000000
SOCKET_HTTP_COMPRESSION=true
SOCKET_COMPRESSION_THRESHOLD=1024
SOCKET_COMPRESSION_CONCURRENCY=10
SOCKET_COMPRESSION_MEM_LEVEL=7
SOCKET_ALLOW_EIO3=false

# Rate Limiting Configuration
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
SOCKET_RATE_LIMIT_CONNECTIONS=10
SOCKET_RATE_LIMIT_CONNECTIONS_HOUR=100

# CORS Configuration
CORS_MAX_AGE=86400

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-in-production

# Notification Configuration
NOTIFICATION_DEFAULT_EXPIRY=2592000000
MAX_NOTIFICATIONS_PER_USER=1000
NOTIFICATION_CLEANUP_INTERVAL=3600000
NOTIFICATION_BATCH_SIZE=100

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m
LOG_DATE_PATTERN=YYYY-MM-DD

# Email Configuration (Optional)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=notifications@yourapp.com

# SMS Configuration (Optional - Twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Push Notifications (Optional - Web Push)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@yourapp.com

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-for-signature-verification
WEBHOOK_TIMEOUT=30000
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=1000

# Redis Configuration (Optional - for scaling)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=notification:
REDIS_TTL=3600

# Health Check Configuration
HEALTH_CHECK_INTERVAL=300000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# API Configuration
API_VERSION=v1
API_PREFIX=/api
API_TIMEOUT=30000
MAX_REQUEST_SIZE=10mb

# Development/Testing
DEBUG=notification:*
VERBOSE_LOGGING=false

# Production Only Settings
# SSL_KEY_PATH=/path/to/ssl/key.pem
# SSL_CERT_PATH=/path/to/ssl/cert.pem
# CLUSTER_WORKERS=auto

# External Services (Optional)
# SENTRY_DSN=your-sentry-dsn-for-error-tracking
# ANALYTICS_API_KEY=your-analytics-api-key
# METRICS_ENDPOINT=your-metrics-endpoint

# Database Backup (Optional)
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=your-backup-bucket

# Load Balancer Settings (Optional)
# CLUSTER_MODE=true
# STICKY_SESSIONS=true
# SESSION_STORE=redis